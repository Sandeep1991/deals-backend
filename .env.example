# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://dealssearch.search.windows.net
AZURE_SEARCH_API_KEY=your-admin-or-query-key
AZURE_SEARCH_INDEX=ads
AZURE_SEARCH_SEMANTIC_CONFIG=ads-semantic
AZURE_SEARCH_VECTOR_FIELD=

# Search tuning (filters weak matches like tea for "shower")
MIN_SEARCH_SCORE=1.0
MIN_RERANKER_SCORE=1.5
SEARCH_TOP_K=10
SEARCH_RESULT_LIMIT=5

# Reply generation for simple search: template | ollama | azure_openai
REPLY_PROVIDER=template

# Store comparison / meal planning (requires LLM for generalized queries)
# auto = Azure OpenAI if configured, else Ollama | azure_openai | ollama | template
DECOMPOSE_PROVIDER=auto

# Ollama (local dev — run: ollama serve && ollama pull llama3.2:1b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Azure OpenAI / AI Foundry (recommended for generalized meal planning)
# Resource endpoint — NOT the /api/projects/... URL from Foundry portal
# AZURE_OPENAI_ENDPOINT=https://deals-llm.services.ai.azure.com
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
# AZURE_OPENAI_API_STYLE=auto

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://thetinkerer.xyz,https://www.thetinkerer.xyz
